{
  "name": "yingyou-workshop",
  "version": "1.0.0",
  "description": "影游工坊 - 零代码拖拽式影视互动游戏编辑器（基于 Ren'Py 8.x）",
  "author": "影游工坊",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "adm-zip": "^0.5.12",
    "chokidar": "^3.6.0",
    "jszip": "^3.10.1",
    "lowdb": "^7.0.1",
    "nanoid": "^5.0.4",
    "pixi.js": "^8.2.0",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "zundo": "^2.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "wait-on": "^7.2.0"
  }
}
